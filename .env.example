MONGODB_URI=
MONGODB_DB=apex_nexus

# 凭证未配齐前保持 dry-run，避免误调 Google Ads
GOOGLE_ADS_DRY_RUN=true

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# 飞书 OAuth（配置后启用登录与路由保护）
# 飞书开放平台 -> 创建企业自建应用 -> 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 可选；未设置时使用当前请求域名 + /api/auth/feishu/callback
FEISHU_REDIRECT_URI=
# 会话签名密钥，建议使用 openssl rand -base64 32 生成
AUTH_SECRET=
